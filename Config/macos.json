{
  "$schema": "https://tui-cs.github.io/Terminal.Gui/schemas/tui-config-schema.json",
  "Application": {
    "DefaultKeyBindings": {
      "Quit": { "All": [ "Esc", "Ctrl+Q" ] },
      "Suspend": { "All": [ "Ctrl+Z" ] }
    }
  },
  "View": {
    "DefaultKeyBindings": {
      "Undo": { "All": [ "Ctrl+Z", "Ctrl+/" ] },
      "Redo": { "All": [ "Ctrl+Y", "Ctrl+Shift+Z" ] }
    },
    "ViewKeyBindings": {
      "TextField": {
        "KillWordRight": { "All": [ "Ctrl+W" ] }
      }
    }
  }
}
